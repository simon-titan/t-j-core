# =============================================================================
# T&J CRM — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Required
# Find these in: https://supabase.com/dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# Storage
# Bucket must be created manually in Supabase Dashboard (public, no RLS needed).
# Supabase Dashboard → Storage → New bucket → Name: "org-logos" → Public: on
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_ORG_LOGOS=org-logos

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="T&J CRM"

# -----------------------------------------------------------------------------
# Notifications Cron
# Secret used to authenticate POST /api/notifications/generate
# Set this to a random string (e.g. openssl rand -hex 32) in .env.local
# and use the same value in your external cron service (cron-job.org, etc.)
# or Supabase Edge Function scheduler.
# If pg_cron is enabled in Supabase, this route is not needed.
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# E-Mail / SMTP
# Used for transactional emails (notification digests, invite links).
# Configured in a later implementation step.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="T&J CRM <noreply@titandevelopment.de>"

# -----------------------------------------------------------------------------
# LinkedIn OAuth
# Required for the future LinkedIn API integration (import contacts, track reads).
# Register at: https://www.linkedin.com/developers/apps
# -----------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/callback/linkedin

# -----------------------------------------------------------------------------
# Analytics (optional)
# Self-hostable via eu.posthog.com for GDPR compliance.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
